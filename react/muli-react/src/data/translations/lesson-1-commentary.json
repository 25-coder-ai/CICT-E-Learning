{
  "lesson": 1,
  "heading": "பதவுரை",
  "entries": [
    { "phrase": "முள் தயிர் பிசைந்த", "explanation": "முற்றிய தயிரைப் பிசைந்த" },
    { "phrase": "காந்தள் மெல் விரல்", "explanation": "காந்தள் மலரைப் போன்ற மெல்லியவிரல்" },
    { "phrase": "கழுவுறு கலிங்கம்", "explanation": "கழுவுதல் கொண்ட ஆடை" },
    { "phrase": "கழாஅது உடீஇ", "explanation": "துவையாமல் உடுத்துக்கொண்டு" },
    { "phrase": "குவளை உண்கண்", "explanation": "குவளை மலரைப் போன்ற மையுண்ட கண்களில்" },
    { "phrase": "குய் புகை கமழ", "explanation": "தாளிப்பினது புகை மணப்ப" },
    { "phrase": "தான் துழந்து அட்ட", "explanation": "தானே துழாவிச் சமைத்த" },
    { "phrase": "தீம் புளிப் பாகர்", "explanation": "இனிய புளிப்பையுடைய குழம்பை" },
    { "phrase": "கணவன்", "explanation": "தன் கணவன்" },
    { "phrase": "இனிது என உண்டலின்", "explanation": "இனிதென்று உண்பதனால்" },
    { "phrase": "ஒள்நுதல் முகன்", "explanation": "தலைவியின் ஒளிபொருந்திய நெற்றியினை யுடைய முகமானது" },
    { "phrase": "நுண்ணிதின் மகிழ்ந்தன்று", "explanation": "நுண்ணிதாக மகிழ்ந்தது" }
  ]
