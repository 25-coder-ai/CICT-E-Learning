{
  "lesson": 1,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "muḷitayir picainta kāntal melviral",
    "kaḷuvuṟu kaliṅkam kaḷāatu uṭīik",
    "kuvaḷai uṇkaṇ kuyppukai",
    "kamaḻat",
    "tāntuḻantu aṭṭa tīmpuḷip pākar",
    "iṉitu eṉak kaṇavan uṇṭaliṉ",
    "nuṇṇitiṉ makiḻntanṟu oṇṇutal",
    "mukaṉē"
  ]
}
