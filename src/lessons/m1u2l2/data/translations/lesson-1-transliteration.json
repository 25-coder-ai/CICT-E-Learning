{
  "lesson": 2,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "nīrniṟam karappa ūḻuṟupu utirntu",
    "pūmalar kañaliya kaṭuvaral kāṉyāṟṟu",
    "karāam tuñcum kaluyar maṟicuḻi",
    "marāa yāṉai matamtapa oṟṟi",
    "urāa īrkkum uṭkuvaru nīttam",
    "kaṭuṅkaṇ paṉṟiyiṉ naṭuṅkātu tuṟantu",
    "nāma aruntuṟaip pērtantu yāmattu",
    "īṅkum varupavō ōṅkal veṟpa",
    "orunāḷ viḻumam uṟiṉum vaḻināḷ",
    "vāḻkuvaḷ allaḷ eṉtōḻi yāvatum",
    "ūṟuil vaḻikaḷum payila vaḻaṅkunar",
    "nīṭuiṉṟu āka iḻukkuvar ataṉāl",
    "ulamaral varuttam uṟutum em paṭappaik",
    "koṭuntēṉ iḻaitta kōṭuuyar neṭuvarai",
    "paḻamtūṅku naḷippiṉ kāntaḷam potumpil",
    "pakalnī variṉum puṇarkuvai akalmalai",
    "vāṅkuamaik kaṇiṭai kaṭuppa yāy",
    "ōmpiṉaḷ eṭutta taṭameṉ tōḷē."
  ]
}
