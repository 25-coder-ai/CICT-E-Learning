{
  "lesson": 1,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "ciṟuvī mullaip peritukamaḻ alari",
    "tāṉum cūṭiṉaṉ iḷaiñarum malaintaṉar",
    "vicumpu kaṭappu aṉṉa polampaṭaik kalimā",
    "paṭumaḻai poḻinta taṇnaṟum puṟavil",
    "neṭunā oṇmaṇi pāṭuciṟantu icaippa",
    "mālai māṉṟa maṇaṉmali viyaṉ nakart",
    "tantaṉa neṭuntakai tērē eṉṟum",
    "arumpaṭar akala nīkki",
    "viruntuayar viruppiṉaḷ tiruntu iḻaiyōḷē"
  ]
}
