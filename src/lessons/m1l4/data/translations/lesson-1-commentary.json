{
  "lesson": 4,
  "heading": "பதவுரை",
  "entries": [
    {
      "phrase": "நாஞ்சில் வலவன்",
      "explanation": "கலப்பைப்படை வென்றியையுடையவனது"
    },
    {
      "phrase": "நிறம்போல",
      "explanation": "வெண்ணிறம் போல"
    },
    {
      "phrase": "பூஞ்சினை",
      "explanation": "பூங்கொம்பினையும்"
    },
    {
      "phrase": "செங்கால்",
      "explanation": "செவ்வியதாளினையுமுடைய"
    },
    {
      "phrase": "மராஅம்",
      "explanation": "வெண்கடம்புகள், தகைந்தன- மலர்ந்தன"
    },
    {
      "phrase": "(ஆதலால்) என் நெஞ்சு",
      "explanation": "என் மனம்"
    },
    {
      "phrase": "பைங்கோல் தொடி",
      "explanation": "அழகிய பசும்பொன் வளைகள்"
    },
    {
      "phrase": "பொலி",
      "explanation": "விளங்குகின்ற"
    },
    {
      "phrase": "முன்கையாள்",
      "explanation": "முன்னங்கையை யுடையாளின்"
    },
    {
      "phrase": "தோள்",
      "explanation": "தோள்கள்"
    },
    {
      "phrase": "துணையாவேண்டி",
      "explanation": "எனக்குத் துணையாக வேண்டி"
    },
    {
      "phrase": "நெடு இடைச் சென்றது",
      "explanation": "நெடிய காட்டுவழியைக் கடந்து சென்றது."
    }
  ]
}