    { "phrase": "பெருந்தேன் இழைக்கும்", "explanation": "பெரிய தேனடையை வண்டுகள் செய்தற்கு இடமாகிய" },
    { "phrase": "நாடனொடு நட்பு", "explanation": "நாட்டை உடைய தலைவனோடு யான் செய்த நட்பானது" },
    { "phrase": "நிலத்தினும் பெரிது", "explanation": "நிலத்தைக் காட்டிலும் அகலம் உடையது" },
