  "lesson": 8,
  "heading": "பதவுரை",
  "entries": [
    {
      "phrase": "ஐவளம் பூத்த அணிதிகழ் குன்றின்மேல்",
      "explanation": "(ஐவளம் பூத்த அணிதிகழ் குன்றின்மேல் — பொருள் காண்க)"
    },
    {
      "phrase": "மைவளம் பூத்த மலர்ஏர் மழைக்கண்ணார்",
      "explanation": "(மைவளம் பூத்த மலர்ஏர் மழைக்கண்ணார் — பொருள் காண்க)"
    },
    {
      "phrase": "கைவளம் பூத்த வடுவொடு காணாய்நீ",
      "explanation": "(கைவளம் பூத்த வடுவொடு காணாய்நீ — பொருள் காண்க)"
    },
    {
      "phrase": "மொய்வளம் பூத்த முயக்கம்யாம் கைப்படுத்தேம்",
      "explanation": "(மொய்வளம் பூத்த முயக்கம்யாம் கைப்படுத்தேம் — பொருள் காண்க)"
    },
    {
      "phrase": "மெய்வளம் பூத்த விழைதகு பொன்அணி",
      "explanation": "(மெய்வளம் பூத்த விழைதகு பொன்அணி — பொருள் காண்க)"
    },
    {
      "phrase": "நைவளம் பூத்த நரம்புஇயைசீர்ப் பொய்வளம்",
      "explanation": "(நைவளம் பூத்த நரம்புஇயைசீர்ப் பொய்வளம் — பொருள் காண்க)"
    },
    {
      "phrase": "பூத்தன பாணாநின் பாட்டு",
      "explanation": "(பூத்தன பாணாநின் பாட்டு — பொருள் காண்க)"
