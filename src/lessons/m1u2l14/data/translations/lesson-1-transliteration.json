{
  "lesson": 14,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "niṉṟa collar nīṭutōṉṟu iṉiyar",
    "eṉṟum eṉtōḷ piripu  aṟiyalarē",
    "tāmarait taṇtātu ūti   mīmicaic",
    "cāntil toṭutta tīntēṉ pōlap",
    "puraiya maṉṟa  puraiyōr kēṇmai",
    "nīriṉṟu amaiyā ulakam pōlat",
    "tamiṉṟu amaiyā namnayantu aruḷi",
    "naṟunutal pacattal añcic",
    "ciṟumai uṟupavō ceypu  aṟiyalarē"
  ]
}
