{
  "lesson": 8,
  "heading": "பதவுரை",
  "entries": [
    { "phrase": "யாயும்", "explanation": "என்னுடைய தாயும்" },
    { "phrase": "ஞாயும்", "explanation": "நின் தாயும்" },
    { "phrase": "யார் ஆகியரோ", "explanation": "ஒருவருக்கொருவர் எத்தகைய தொடர்புடையவர்" },
    { "phrase": "எந்தையும்", "explanation": "என் தந்தையும்" },
    { "phrase": "நுந்தையும்", "explanation": "நின் தந்தையும்" },
    { "phrase": "எம்முறைக் கேளிர்", "explanation": "எந்த முறையில் உறவினர்" },
    { "phrase": "யானும் நீயும்", "explanation": "இப்பொழுது பிரிவின்றியிருக்கும் யானும் நீயும்" },
    { "phrase": "எவ் வழி அறிதும்", "explanation": "ஒருவரையொருவர் எவ்வாறு முன்பு அறிந்தோம்" },
    { "phrase": "செம்புலப் பெயல் நீர் போல", "explanation": "செம்மண் நிலத்தின்கண்ணே பெய்த மழைநீர் அம்மண்ணோடு கலந்து அதன் தன்மையை அடைதல் போல" },
    { "phrase": "அன்பு உடை நெஞ்சம்", "explanation": "அன்பு உடைய நம் நெஞ்சம்" },
    { "phrase": "தாம் கலந்தன", "explanation": "தாமாகவே ஒன்றுபட்டன" }
  ]
}
