{
  "lesson": 1,
  "heading": "ஒலிபெயர்ப்பு",
  "lines": [
    "eḻilmaruppu eḻilvēḻam ikutaru kaṭāttāl",
    "toḻilmāṟit talaivaitta tōṭṭikai nimirntāṅku",
    "aṟivumnam aṟivuāynta aṭakkamum nāṇoṭu",
    "vaṟitākap piṟareṉṉai nakupavum nakapu",
    "uṭaṉmiṉavir nuṭakkamum kaṉavumpōl meykāṭṭi",
    "eṉneñcam eṉṉōṭu nillāmai naṉivauvit",
    "taṉnalam karantāḷait talaippaṭumāṟu evaṉkolō",
    "maṇippīli cūṭṭiya nūloṭu maṟṟai",
    "aṇippūḷai āvirai erukkoṭu piṇittu",
    "yāttu mallalūr maṟukiṉkaṇ ivaṭpāṭum iḵtuottaṉ",
    "ellīrum kēṭṭīmiṉ eṉṟu",
    "paṭarum paṉaiīṉṟa māvum cuṭariḻai",
    "nalkiyāḷ nalkiyavaipoṟai",
    "eṉ varaittuaṉṟip pūnutal ītta",
    "niṟaiyaḻi kāmanōy nīnti aṟaiuṟṟa",
    "uppiyal pāvai uṟaiyuṟṟatu pōla",
    "ukku viṭumeṉ uyir",
    "pūḷai polamalar āvirai vēyveṉṟa",
    "tōḷāḷ emakkuītta pū",
    "uritueṉ varaittuaṉṟi oḷḷiḻai tanta",
    "paricuaḻi paitalnōy mūḻki eriparanta",
    "neyyuḷ meḻukiṉ nilaiyātu paipayattēyum aḷittu",
    "eṉ uyir",
    "iḷaiyārum ētilavarum uḷaiya",
    "yāṉuṟṟatu ucāvum tuṇaieṉṟu",
    "yāṉ pāṭak kēṭṭu",
    "aṉpuṟu kiḷaviyāḷ aruḷivantu aḷittaliṉ",
    "tuṉpattil tuṇaiyāya maṭaliṉi ivaṭpeṟa",
    "iṉpattuḷ iṭampaṭaleṉṟu iraṅkiṉaḷ aṉpuṟṟu",
    "aṭaṅkarum tōṟṟattu aruntavam muyaṉṟōrtam",
    "uṭampuoḻittu uyarulaku iṉitupeṟṟāṅkē"
  ]
}