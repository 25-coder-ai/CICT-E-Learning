    },
    {
      "phrase": "ஆண்எழில் அண்ணலோடு அருஞ்சுரம் முன்னிய",
      "explanation": "(ஆண்எழில் அண்ணலோடு அருஞ்சுரம் முன்னிய — பொருள் காண்க)"
    },
    {
      "phrase": "மாண்இழை மடவரல் தாயிர்நீர் போறீர்",
      "explanation": "(மாண்இழை மடவரல் தாயிர்நீர் போறீர் — பொருள் காண்க)"
    },
    {
      "phrase": "பலஉறு நறுஞ்சாந்தம் படுப்பவர்க்கு அல்லதை",
      "explanation": "(பலஉறு நறுஞ்சாந்தம் படுப்பவர்க்கு அல்லதை — பொருள் காண்க)"
    },
    {
      "phrase": "மலையுளே பிறப்பினும் மலைக்குஅவைதாம் என்செய்யும்",
      "explanation": "(மலையுளே பிறப்பினும் மலைக்குஅவைதாம் என்செய்யும் — பொருள் காண்க)"
    },
    {
      "phrase": "நினையுங்கால் நும்மகள் நுமக்கும்ஆங்கு அனையளே",
      "explanation": "(நினையுங்கால் நும்மகள் நுமக்கும்ஆங்கு அனையளே — பொருள் காண்க)"
    },
    {
