  "lesson": 6,
  "heading": "பதவுரை",
  "entries": [
    { "phrase": "அம் தீம் தெள் நீர்", "explanation": "அம் மலைக்கண்ணதாகிய அழகிய இனிய தெளிந்த அருவி நீரை" },
    { "phrase": "குடித்தலின்", "explanation": "அவன் குடித்தமையானே" },
    { "phrase": "நெஞ்சு அமர்ந்து", "explanation": "இவள் நெஞ்சு அவன் சூளுரைத்தலில் பொருந்தி" },
    { "phrase": "அருவிடர் அமைந்த", "explanation": "அரிய காட்டினிடத்தே பொருந்திய" },
    { "phrase": "களிறு தருபுணர்ச்சி", "explanation": "களிற்றாலே கூட்டப்பட்ட அக்கூட்டத்தை" },
    { "phrase": "வான் உரி உறையுள்", "explanation": "விசும்பின்கண் தமக்குரிய இருப்பினை உடைய" },
    { "phrase": "வயங்கியோர்", "explanation": "தேவர்களும்" },
    { "phrase": "அவாவும்", "explanation": "விழைதற்குக் காரணமான" },
    { "phrase": "பூ மலி சோலை", "explanation": "பூக்கள் நிறைந்ததொரு பொழிலினூடே" },
    { "phrase": "அப்பகல்", "explanation": "அன்றைய பகற்பொழுதெல்லாம்" },
    { "phrase": "கழிப்பி", "explanation": "கழித்து" },
    { "phrase": "எல்லை செல்ல", "explanation": "பகற்பொழுது போம்படி" },
    { "phrase": "ஏழ் ஊர்பு இறைஞ்சி", "explanation": "ஏழுகுதிரை பூண்ட தேரைச் செலுத்தி" },
    { "phrase": "பல்கதிர் மண்டிலம் கல்சேர்பு மறைய", "explanation": "பல கதிர்களையுடைய கதிரவன் மலையை அடைந்து மறைய" }
  ]
