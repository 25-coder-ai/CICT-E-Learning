{
  "lesson": 6,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "amtīm teḷnīr kuṭittaliṉ neñcamarntu",
    "aruviṭar amainta kaḷiṟutaru puṇarcci",
    "vāṉuri uṟaiyuḷ vayaṅkiyōr avāvum",
    "pūmali cōlai appakal kaḻippi",
    "ellai cella ēḻūrpu iṟaiñcip",
    "palkatir maṇṭilam kalcērpu maṟaiya"
  ]
}
