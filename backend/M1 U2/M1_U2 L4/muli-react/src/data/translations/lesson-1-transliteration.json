{
  "lesson": 4,
  "heading": "எழுத்துப்பெயர்ப்பு",
  "lines": [
    "kāṉa māṉatar yāṉaiyum vaḻaṅkum",
    "vāṉa mīmicai urumumnaṉi uraṟum",
    "aravum puliyum añcutakavu uṭaiya",
    "iravuc ciṟuneṟi tamiyai varuti",
    "varaiiḻi aruvip pāṭṭoṭu piracam",
    "muḻavucēr narampiṉ immeṉa imirum",
    "paḻaviṟal naṉantalaip payamalai nāṭa",
    "maṉṟal vēṇṭiṉum peṟukuvai oṉṟō",
    "iṉṟu talaiyāka vāral variṉē",
    "ēmuṟu tuyaram yām ivaṇ oḻiya",
    "eṉkaṇṭu peyarum kālai yāḻaniṉ",
    "kalkeḻu ciṟukuṭi eytiya piṉṟai",
    "ūtal vēṇṭumāl ciṟitē vēṭṭoṭu",
    "vēypayil aḻuvattup pirintaniṉ",
    "nāypayir kuṟinilai koṇṭa kōṭē"
  ]
}
