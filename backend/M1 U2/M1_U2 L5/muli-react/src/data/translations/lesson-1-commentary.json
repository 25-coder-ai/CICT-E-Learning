    { "phrase": "அடைச்சிய கோதை பரிந்து", "explanation": "கூந்தலில் செருகியிருந்த பூமாலையைப் பறித்து" },
    { "phrase": "வரிப்பந்து கொண்டுஓடி", "explanation": "அழகிய பந்தினைப் பறித்துக் கொண்டு ஓடி" },
