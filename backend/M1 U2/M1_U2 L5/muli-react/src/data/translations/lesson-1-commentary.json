    { "phrase": "மேலோர்நாள்", "explanation": "முன்னொரு நாளிலே" },
    { "phrase": "அன்னையும் யானும் இருந்தேமா", "explanation": "அன்னையும் நானும் இருந்தபொழுது" },
    { "phrase": "இல்லிரே உண்ணுநீர் வேட்டேன்", "explanation": "இல்லில் வாழ்வீரே நீர் வேட்கை கொண்டேன்" },
    { "phrase": "எனவந்தாற்கு", "explanation": "என வந்தானுக்கு" },
