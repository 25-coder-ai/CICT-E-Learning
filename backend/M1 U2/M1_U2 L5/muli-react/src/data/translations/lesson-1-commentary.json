    { "phrase": "அன்னை அலறிப் படர்தரத் தன்னையான் உண்ணுநீர் விக்கினான் என்றேனா", "explanation": "அன்னை அலறிக் கொண்டு ஓடிவர அவன் உண்ட நீர் விக்கினான் என்று நான் கூற" },
    { "phrase": "அன்னையும் தன்னைப் புறம்பழித்து நீவ", "explanation": "அன்னையும் மெல்லக் கடிந்து அவனது முதுகினைத் தடவ" },
    { "phrase": "மற்று என்னைக் கடைக்கணால் கொல்வான்போல் நோக்கி", "explanation": "அவனோ என்னைக் கொல்வது போல் தன் கடைக்கண்ணால் பார்த்து" },
    { "phrase": "நகைக்கூட்டம் செய்தான்", "explanation": "குறும்பாக முறுவல்செய்து இன்பம் தந்தான்" },
    { "phrase": "அக் கள்வன் மகன்", "explanation": "அக் கள்ளத்தனமுடைய தலைவன்" }
  ]
