    { "phrase": "அடர்பொற் சிரகத்தால் வாக்கி", "explanation": "பொன்னாற் செய்த சிறு செம்பில் நீரை ஊற்றி" },
    { "phrase": "சுடரிழாய்", "explanation": "ஒளிவீசும் கலனணிந்தவளே" },
    { "phrase": "உண்ணுநீர் ஊட்டிவா என்றாள்", "explanation": "உண்ணற்கு நீர் தந்து வா என்றாள்" },
    { "phrase": "என யானும் தன்னை அறியாது சென்றேன்", "explanation": "எனவே நானும் அவன்தான் என்பதறியாது சென்றேன்" },
    { "phrase": "மற்று என்னை வளைமுன்கை பற்றி நலிய", "explanation": "சென்றபோது என் வளையணிந்த முன் கையினைப் பிடித்து அழுத்த" },
