{
  "lesson": 14,
  "heading": "பதவுரை",
  "entries": [
    { "phrase": "நின்ற சொல்லர்", "explanation": "நம் காதலர் சொல்லிய சொல் தவறாதவர்" },
    { "phrase": "நீடு தோன்று இனியர்", "explanation": "உயர்ந்து தோன்றும் இயல்பினர்" },
    { "phrase": "என்றும் என்தோள் பிரிபு அறியலர்", "explanation": "என்றும் என் தோள்களைப் பிரியும் எண்ணம் உடையவர் அல்லர்" },
    { "phrase": "தாமரைத் தண்தாது ஊதி", "explanation": "தாமரையின் தண்ணிய தேனினை எடுத்து" },
    { "phrase": "மீமிசை சாந்தின் தொடுத்த தீந்தேன் போல", "explanation": "உயர்ந்த சந்தனமரத்தில் வைத்த இனிய தேன்போல" },
    { "phrase": "புரைய மன்ற புரையோர் கேண்மை", "explanation": "அம் மேதக்கோருடைய நட்பு" },
    { "phrase": "நீரின்று அமையா உலகம் போல", "explanation": "நீரை இன்றியமையாததாகக் கொண்ட உலகம் போல" },
    { "phrase": "தம்மின்று அமையா நம்நயந்து அருளி", "explanation": "தம்மை இன்றியமையாத நம்பால் விருப்பம் மிக வைத்து அருளி" },
    { "phrase": "நறுநுதல் பசத்தல் அஞ்சி", "explanation": "நம் நறிய நுதல் பசத்தல் அஞ்சி" },
    { "phrase": "சிறுமை உறுபவோ செய்பு அறியலரே", "explanation": "சிறுமை உறுவதற்கு உரிய ஒன்றைச் செய்ய மாட்டார்" }
  ]
