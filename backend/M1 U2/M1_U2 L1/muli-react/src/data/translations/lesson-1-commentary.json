{
  "lesson": 1,
  "heading": "பதவுரை",
  "entries": [
    { "phrase": "அம்ம வாழி தோழி", "explanation": "தோழி வாழ்க! கேட்பாயாக" },
    { "phrase": "அன்னைக்கு", "explanation": "அன்னைக்கு" },
    { "phrase": "அவர் மலை", "explanation": "தலைவருடைய மலையிலே" },
    { "phrase": "மாலைப் பெய்த", "explanation": "மாலைக் காலத்திலே பெய்த மழையினால் உண்டாகிய" },
    { "phrase": "மணங் கமழ் உந்தியொடு", "explanation": "நறுமணம் கமழும் ஆற்று வெள்ளத்தோடு" },
    { "phrase": "காலை வந்த காந்தள்", "explanation": "காலையில் இங்கு வந்த காந்தளை" },
    { "phrase": "முழுமுதல்", "explanation": "கிழங்குடன் கூடிய செடியை" },
    { "phrase": "மெல் இலை குழைய முயங்கலும்", "explanation": "மெல்லிய இலையானது குழையும்படி தழுவுதலையும்" },
    { "phrase": "இல்உய்த்து நடுதலும்", "explanation": "இல்லத்திற்குக் கொணர்ந்து அதனை நடுதலையும்" },
    { "phrase": "கடியாதோள்", "explanation": "விலக்காதவளாகிய தாய்க்கு" },
    { "phrase": "உயர்நிலை உலகமும்", "explanation": "உயர்ந்த நிலையாகிய தேவருலகும்" },
    { "phrase": "சிறிது", "explanation": "கைம்மாறாகக் கருதுமிடத்துச் சிறிதாகும்" }
  ]
}
